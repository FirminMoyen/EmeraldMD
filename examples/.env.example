# Copy to .env next to docker-compose.yml.

# The domain name that points at this machine. Caddy gets its certificate.
EMERALDMD_DOMAIN=notes.example.com

# Owner (uid:gid) of ./vaults and ./config; see `id -u` and `id -g`.
EMERALDMD_UID=1000
EMERALDMD_GID=1000

# Image to run, if not built locally as emeraldmd-server.
# EMERALDMD_IMAGE=ghcr.io/firminmoyen/emeraldmd-server:0.1
